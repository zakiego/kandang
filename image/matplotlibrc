## Kandang's house style for matplotlib: a light surface, Inter, and a
## colorblind-checked categorical palette (in fixed order). Every run gets it
## through MPLCONFIGDIR=/opt/mpl; code that sets its own style still wins.
## sitecustomize.py adds the defaults an rc file can't hold (bar width, pie gaps).

## Surface and text
figure.figsize:     8, 5
figure.facecolor:   fcfcfb
axes.facecolor:     fcfcfb
savefig.facecolor:  auto   # follows the figure, so code that sets its own background wins
text.color:         0b0b0b
axes.titlecolor:    0b0b0b
axes.labelcolor:    52514e
axes.edgecolor:     d9d8d3
xtick.color:        52514e
ytick.color:        52514e
legend.labelcolor:  52514e

## Type
font.family:        Inter, DejaVu Sans
font.size:          11
axes.titlesize:     16
axes.titleweight:   semibold
axes.titlelocation: left
axes.titlepad:      16
axes.labelpad:      8

## Series colors, in this order (light steps of the palette)
axes.prop_cycle:    cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])

## Marks
lines.linewidth:        2.2
lines.solid_capstyle:   round
lines.solid_joinstyle:  round
lines.markersize:       7
patch.linewidth:        0

## Frame: no box, a baseline, hairline horizontal grid behind the data
axes.spines.top:    False
axes.spines.right:  False
axes.spines.left:   False
axes.grid:          True
axes.grid.axis:     y
axes.axisbelow:     True
axes.xmargin:       0.03
grid.color:         ebeae6
grid.linewidth:     0.8
grid.linestyle:     -
xtick.major.size:   0
ytick.major.size:   0
xtick.major.pad:    8
ytick.major.pad:    8

## Legend
legend.frameon:         False
legend.handlelength:    1.2
legend.handleheight:    0.8
legend.borderaxespad:   0

## Output: sharp on a phone, with room around the chart
savefig.dpi:        200
savefig.bbox:       tight
savefig.pad_inches: 0.35
