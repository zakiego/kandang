## Kandang's house style for matplotlib: a dark surface, Inter, and a
## colorblind-checked categorical palette (in fixed order). Every run gets it
## through MPLCONFIGDIR=/opt/mpl; code that sets its own style still wins.
## sitecustomize.py adds the defaults an rc file can't hold (bar width, pie gaps).

## Surface and text
figure.figsize:     8, 5
figure.facecolor:   0f1011
axes.facecolor:     0f1011
savefig.facecolor:  0f1011
text.color:         f7f8f8
axes.titlecolor:    f7f8f8
axes.labelcolor:    8a8f98
axes.edgecolor:     34343a
xtick.color:        8a8f98
ytick.color:        8a8f98
legend.labelcolor:  8a8f98

## Type
font.family:        Inter, DejaVu Sans
font.size:          11
axes.titlesize:     16
axes.titleweight:   semibold
axes.titlelocation: left
axes.titlepad:      16
axes.labelpad:      8

## Series colors, in this order (dark steps of the palette)
axes.prop_cycle:    cycler('color', ['3987e5', 'd95926', '199e70', 'c98500', 'd55181', '0ca30c', '9085e9', 'e66767'])

## Marks
lines.linewidth:        2.2
lines.solid_capstyle:   round
lines.solid_joinstyle:  round
lines.markersize:       7
patch.linewidth:        0

## Frame: no box, a baseline, hairline horizontal grid behind the data
axes.spines.top:    False
axes.spines.right:  False
axes.spines.left:   False
axes.grid:          True
axes.grid.axis:     y
axes.axisbelow:     True
axes.xmargin:       0.03
grid.color:         23252a
grid.linewidth:     0.8
grid.linestyle:     -
xtick.major.size:   0
ytick.major.size:   0
xtick.major.pad:    8
ytick.major.pad:    8

## Legend
legend.frameon:         False
legend.handlelength:    1.2
legend.handleheight:    0.8
legend.borderaxespad:   0

## Output: sharp on a phone, with room around the chart
savefig.dpi:        200
savefig.bbox:       tight
savefig.pad_inches: 0.35
